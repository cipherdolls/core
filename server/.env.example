# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/server
JWT_SECRET_KEY=change-me

# ── LLM (OpenAI-compatible chat model) ────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_PATH=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# ── STT (Groq Whisper) ────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── TTS (Kokoro, self-hosted) ─────────────────────────────
CIPHERDOLLS_KOKORO_URL=http://localhost:8880

# ── Optional ──────────────────────────────────────────────
PORT=4000
# Enable the BullMQ worker process (run `bun run worker`)
ASSETS_PATH=./uploads
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_KEY=
# Admin/seed wallet (also the first ADMIN user on signin)
MASTER_WALLET_ADDRESS=0x0000000000000000000000000000000000000001
